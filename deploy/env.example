# Copy to /opt/tara/.env on the server and fill in. Never commit the real file.
JWT_SECRET=CHANGE_ME_LONG_RANDOM            # openssl rand -hex 32
PIPELINE_SERVICE_SECRET=CHANGE_ME_LONG_RANDOM
LLM_PROVIDER=openrouter                      # or: anthropic
OPENROUTER_API_KEY=                          # if provider=openrouter
ANTHROPIC_API_KEY=                           # if provider=anthropic
# LLM_MODEL=
REGISTRATION_INVITE_CODE=CHANGE_ME_SHARE_ONLY_WITH_PEOPLE_YOU_INVITE   # openssl rand -hex 8
# AI switch. `false`: nothing calls a model (Execute, Rebuild and Run answer "AI is switched off in this preview")
# and testers get the ready-made demo TARA after login. Leave it out, or set `true`, once a model key is set above.
# The API reads it at start: change it here, then restart the api container.
AI_ENABLED=true
# DEMO_ENABLED=true                          # optional: offer the demo TARA even with AI on (default: only with AI off)
