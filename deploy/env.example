# Copy to /opt/tara/.env on the server and fill in. Never commit the real file.
JWT_SECRET=CHANGE_ME_LONG_RANDOM            # openssl rand -hex 32
PIPELINE_SERVICE_SECRET=CHANGE_ME_LONG_RANDOM
LLM_PROVIDER=openrouter                      # or: anthropic
OPENROUTER_API_KEY=                          # if provider=openrouter
ANTHROPIC_API_KEY=                           # if provider=anthropic
# LLM_MODEL=
REGISTRATION_INVITE_CODE=CHANGE_ME_SHARE_ONLY_WITH_PEOPLE_YOU_INVITE   # openssl rand -hex 8
