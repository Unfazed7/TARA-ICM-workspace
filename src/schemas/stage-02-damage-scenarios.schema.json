{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "stage-02-damage-scenarios.schema.json",
  "title": "Stage 02 Damage Scenarios",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "damage_id",
      "asset_id",
      "asset_title",
      "property",
      "damage_scenario",
      "stakeholder_affected",
      "created_timestamp"
    ],
    "properties": {
      "damage_id": { "type": "string", "pattern": "^DS_\\d{2,}$" },
      "asset_id": { "type": "string", "pattern": "^AS_\\d{2,}$" },
      "asset_title": { "type": "string", "minLength": 1 },
      "property": {
        "type": "string",
        "enum": [
          "confidentiality",
          "integrity",
          "availability",
          "authenticity",
          "authorization",
          "non_repudiation"
        ]
      },
      "damage_scenario": {
        "type": "string",
        "minLength": 1,
        "not": { "pattern": "([Aa]ttacker|[Hh]acker|[Mm]alicious actor)" }
      },
      "stakeholder_affected": {
        "type": "string",
        "enum": ["tool_user", "organization", "vehicle_owner", "regulator", "oem"]
      },
      "created_timestamp": { "type": "string", "format": "date-time" }
    }
  },
  "uniqueItemProperties": ["damage_id"]
}
