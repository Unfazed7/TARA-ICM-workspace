{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "stage-03-assets.schema.json",
  "title": "Stage 03 Assets",
  "description": "The assets worth protecting, with their six cybersecurity properties and a plain reason for each (spec 26, D-56). Stages 04 to 10 receive a register in the older shape, written from these (spec 27).",
  "type": "array",
  "uniqueItemProperties": ["asset_id"],
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["asset_id", "family", "name", "type_label", "description", "source", "interface", "reason", "would_change", "fact_ids", "asset_type_row", "properties"],
    "properties": {
      "asset_id": { "type": "string", "pattern": "^(EXT|NET|INF|WL|DS|IAM|API|COMM)-\\d{2,}$" },
      "family": { "type": "string", "enum": ["EXT", "NET", "INF", "WL", "DS", "IAM", "API", "COMM"] },
      "name": { "type": "string", "minLength": 3, "maxLength": 120 },
      "type_label": { "type": "string", "minLength": 2 },
      "description": { "type": "string", "minLength": 10 },
      "source": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ids", "label", "scope"],
        "properties": {
          "kind": { "type": "string", "enum": ["element", "function", "item", "link"] },
          "ids": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^(EL|FN|IF)-\\d{2,}$" } },
          "label": { "type": "string", "minLength": 3 },
          "scope": { "type": "string", "enum": ["in_scope", "interface", "ambiguous"] }
        }
      },
      "interface": { "type": "boolean" },
      "reason": { "type": "string", "minLength": 10, "description": "Plain reason this is an asset worth protecting." },
      "would_change": { "type": "string", "minLength": 10 },
      "fact_ids": { "type": "array", "items": { "type": "string", "pattern": "^FCT-\\d{3,}$" } },
      "asset_type_row": { "type": "boolean", "description": "False when the component's type has no row in the rules table: the model proposed this asset and the analyst must look at it." },
      "properties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["C", "I", "A", "Au", "Az", "NR"],
        "properties": {
          "C": { "$ref": "#/definitions/property" },
          "I": { "$ref": "#/definitions/property" },
          "A": { "$ref": "#/definitions/property" },
          "Au": { "$ref": "#/definitions/property" },
          "Az": { "$ref": "#/definitions/property" },
          "NR": { "$ref": "#/definitions/property" }
        },
        "anyOf": [
          { "properties": { "C": { "properties": { "applies": { "const": true } } } } },
          { "properties": { "I": { "properties": { "applies": { "const": true } } } } },
          { "properties": { "A": { "properties": { "applies": { "const": true } } } } },
          { "properties": { "Au": { "properties": { "applies": { "const": true } } } } },
          { "properties": { "Az": { "properties": { "applies": { "const": true } } } } },
          { "properties": { "NR": { "properties": { "applies": { "const": true } } } } }
        ]
      }
    }
  },
  "definitions": {
    "property": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applies", "reason", "origin", "reviewed"],
      "properties": {
        "applies": { "type": "boolean" },
        "reason": { "type": "string", "minLength": 10, "maxLength": 500 },
        "origin": { "type": "string", "enum": ["default", "model", "analyst"] },
        "reviewed": { "type": "boolean" }
      }
    }
  }
}
