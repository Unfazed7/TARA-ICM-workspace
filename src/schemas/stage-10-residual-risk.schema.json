{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "stage-10-residual-risk.schema.json",
  "title": "Stage 10 Residual Risk",
  "description": "Per threat: the CVSS exploitability metrics, feasibility and risk before controls (pre) and with the Stage 09 controls in place (post). Controls can only make an attack harder (D-55).",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "residual_id",
      "threat_id",
      "risk_id",
      "attack_id",
      "asset_id",
      "treatment_option",
      "controls",
      "pre",
      "post",
      "metric_changes",
      "created_timestamp"
    ],
    "properties": {
      "residual_id": { "type": "string", "pattern": "^RES_\\d{2,}$" },
      "threat_id": { "type": "string", "pattern": "^TH_\\d{2,}$" },
      "risk_id": { "type": "string", "pattern": "^RSK_\\d{2,}$" },
      "attack_id": { "type": "string", "pattern": "^AT_\\d{2,}$" },
      "asset_id": { "type": "string", "pattern": "^AS_\\d{2,}$" },
      "treatment_option": { "type": "string", "enum": ["reduce", "accept", "share", "avoid"] },
      "controls": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["control_id", "control_title", "control_type"],
          "properties": {
            "control_id": { "type": "string", "pattern": "^CTR_\\d{2,}$" },
            "control_title": { "type": "string", "minLength": 1 },
            "control_type": { "type": "string", "enum": ["preventive", "detective", "corrective"] }
          }
        }
      },
      "pre": { "$ref": "#/definitions/state" },
      "post": { "$ref": "#/definitions/state" },
      "metric_changes": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["metric", "from", "to", "control_id", "reason"],
          "properties": {
            "metric": { "type": "string", "enum": ["attack_vector", "attack_complexity", "privileges_required", "user_interaction"] },
            "from": { "type": "string", "enum": ["N", "A", "L", "P", "H", "R"] },
            "to": { "type": "string", "enum": ["N", "A", "L", "P", "H", "R"] },
            "control_id": { "type": "string", "pattern": "^CTR_\\d{2,}$" },
            "reason": { "type": "string", "minLength": 5 }
          }
        }
      },
      "created_timestamp": { "type": "string", "format": "date-time" }
    }
  },
  "definitions": {
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metrics", "afr_value", "afr_label", "risk_score", "risk_level"],
      "properties": {
        "metrics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["attack_vector", "attack_complexity", "privileges_required", "user_interaction"],
          "properties": {
            "attack_vector": { "type": "string", "enum": ["N", "A", "L", "P"] },
            "attack_complexity": { "type": "string", "enum": ["L", "H"] },
            "privileges_required": { "type": "string", "enum": ["N", "L", "H"] },
            "user_interaction": { "type": "string", "enum": ["N", "R"] }
          }
        },
        "afr_value": { "type": "integer", "minimum": 1, "maximum": 5 },
        "afr_label": { "type": "string", "enum": ["very low", "low", "medium", "high", "very high"] },
        "risk_score": { "type": "integer", "minimum": 0, "maximum": 15 },
        "risk_level": { "type": "string", "enum": ["informational", "low", "medium", "high", "critical"] }
      }
    }
  }
}
