{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "stage-03-threats.schema.json",
  "title": "Stage 03 Threats",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "threat_id",
      "damage_scenario_id",
      "asset_id",
      "asset_title",
      "property",
      "stride_category",
      "threat_statement",
      "derivation_note",
      "owasp_reference",
      "created_timestamp"
    ],
    "properties": {
      "threat_id": { "type": "string", "pattern": "^TH_\\d{2,}$" },
      "damage_scenario_id": { "type": "string", "pattern": "^DS_\\d{2,}$" },
      "asset_id": { "type": "string", "pattern": "^AS_\\d{2,}$" },
      "asset_title": { "type": "string", "minLength": 1 },
      "property": {
        "type": "string",
        "enum": [
          "confidentiality",
          "integrity",
          "availability",
          "authenticity",
          "authorization",
          "non_repudiation"
        ]
      },
      "stride_category": {
        "type": "string",
        "enum": [
          "spoofing",
          "tampering",
          "repudiation",
          "information_disclosure",
          "denial_of_service",
          "elevation_of_privilege"
        ]
      },
      "threat_statement": { "type": "string", "minLength": 1 },
      "derivation_note": { "type": "string", "minLength": 1 },
      "owasp_reference": {
        "anyOf": [
          {
            "type": "string",
            "enum": [
              "A01",
              "A02",
              "A03",
              "A04",
              "A05",
              "A06",
              "A07",
              "A08",
              "A09",
              "A10",
              "API1",
              "API2",
              "API3",
              "API4",
              "API5",
              "API6",
              "API7",
              "API8",
              "API9",
              "API10"
            ]
          },
          { "type": "null" }
        ]
      },
      "created_timestamp": { "type": "string", "format": "date-time" }
    }
  },
  "uniqueItemProperties": ["threat_id"]
}
