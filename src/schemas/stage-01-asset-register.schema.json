{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "stage-01-asset-register.schema.json",
  "title": "Stage 01 Asset Register",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "asset_id",
      "asset_title",
      "asset_type",
      "asset_description",
      "ciaaan",
      "input_mode",
      "created_timestamp"
    ],
    "properties": {
      "asset_id": { "type": "string", "pattern": "^AS_\\d{2,}$" },
      "asset_title": { "type": "string", "minLength": 1 },
      "asset_type": {
        "type": "string",
        "enum": [
          "communication_path",
          "data_store",
          "ecu",
          "function",
          "auth_credential",
          "api_endpoint",
          "cloud_service"
        ]
      },
      "asset_description": { "type": "string", "minLength": 1 },
      "ciaaan": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "confidentiality",
          "integrity",
          "availability",
          "authenticity",
          "authorization",
          "non_repudiation"
        ],
        "properties": {
          "confidentiality": { "type": "boolean" },
          "integrity": { "type": "boolean" },
          "availability": { "type": "boolean" },
          "authenticity": { "type": "boolean" },
          "authorization": { "type": "boolean" },
          "non_repudiation": { "type": "boolean" }
        },
        "anyOf": [
          { "properties": { "confidentiality": { "const": true } } },
          { "properties": { "integrity": { "const": true } } },
          { "properties": { "availability": { "const": true } } },
          { "properties": { "authenticity": { "const": true } } },
          { "properties": { "authorization": { "const": true } } },
          { "properties": { "non_repudiation": { "const": true } } }
        ]
      },
      "input_mode": { "type": "string", "enum": ["csv", "diagram"] },
      "created_timestamp": { "type": "string", "format": "date-time" }
    }
  },
  "uniqueItemProperties": ["asset_id"]
}
