{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "stage-07-risk-treatment.schema.json",
  "title": "Stage 07 Risk Treatment",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "treatment_id",
      "risk_id",
      "threat_id",
      "damage_scenario_id",
      "attack_id",
      "impact_id",
      "asset_id",
      "treatment_option",
      "treatment_rationale",
      "cybersecurity_goal",
      "cybersecurity_claim",
      "controls_assigned",
      "avoidance_action",
      "cal",
      "residual_risk_expected",
      "created_timestamp"
    ],
    "properties": {
      "treatment_id": { "type": "string", "pattern": "^TRT_\\d{2,}$" },
      "risk_id": { "type": "string", "pattern": "^RSK_\\d{2,}$" },
      "threat_id": { "type": "string", "pattern": "^TH_\\d{2,}$" },
      "damage_scenario_id": { "type": "string", "pattern": "^DS_\\d{2,}$" },
      "attack_id": { "type": "string", "pattern": "^AT_\\d{2,}$" },
      "impact_id": { "type": "string", "pattern": "^IM_\\d{2,}$" },
      "asset_id": { "type": "string", "pattern": "^AS_\\d{2,}$" },
      "treatment_option": { "type": "string", "enum": ["reduce", "accept", "share", "avoid"] },
      "treatment_rationale": { "type": "string", "minLength": 1 },
      "cybersecurity_goal": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["goal_id", "goal_statement", "cal", "cal_rationale", "self_test_note"],
            "properties": {
              "goal_id": { "type": "string", "pattern": "^CG_\\d{2,}$" },
              "goal_statement": { "type": "string", "minLength": 1 },
              "cal": { "type": "integer", "enum": [1, 2, 3, 4] },
              "cal_rationale": { "type": "string", "minLength": 1 },
              "self_test_note": { "type": "string", "minLength": 1 }
            }
          },
          { "type": "null" }
        ]
      },
      "cybersecurity_claim": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim_id", "claim_statement", "acceptance_basis"],
            "properties": {
              "claim_id": { "type": "string", "pattern": "^CC_\\d{2,}$" },
              "claim_statement": { "type": "string", "minLength": 1 },
              "acceptance_basis": { "type": "string", "minLength": 1 }
            }
          },
          { "type": "null" }
        ]
      },
      "controls_assigned": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["control_id", "control_title", "control_type", "assignment_rationale"],
          "properties": {
            "control_id": { "type": "string", "pattern": "^CTR_\\d{2,}$" },
            "control_title": { "type": "string", "minLength": 1 },
            "control_type": { "type": "string", "enum": ["preventive", "detective", "corrective"] },
            "assignment_rationale": { "type": "string", "minLength": 1 }
          }
        },
        "maxItems": 3
      },
      "avoidance_action": {
        "anyOf": [
          { "type": "string", "minLength": 1 },
          { "type": "null" }
        ]
      },
      "cal": { "type": "integer", "enum": [1, 2, 3, 4] },
      "residual_risk_expected": {
        "type": "string",
        "enum": ["informational", "low", "medium", "high", "critical"]
      },
      "created_timestamp": { "type": "string", "format": "date-time" }
    }
  },
  "uniqueItemProperties": ["treatment_id"]
}
